# Generated from vec2projector.service.in by install.sh -- edit the .in file, not the copy.
#
# The DISPLAY process. It owns the HDMI output and must never exit.
# It does not know or care whether the sender is running.

[Unit]
Description=vec2projector - owns the HDMI output
After=multi-user.target getty@tty1.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DIR@

# Direct-to-HDMI output needs these groups; owning tty1 lets the display switch the
# console to graphics mode so no cursor or text is drawn over the picture.
SupplementaryGroups=video render input tty
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes

Environment=PYTHONUNBUFFERED=1

# Best effort: hide the cursor and stop console blanking. A failure here is not fatal.
ExecStartPre=-/usr/bin/setterm --term linux --blank 0 --powerdown 0 --cursor off

# No desktop, so vec2projector picks kmsdrm and falls back to writing /dev/fb0.
# --splash shows a test card until the first frame arrives.
ExecStart=/usr/bin/python3 @DIR@/vec2projector.py --no-stdin --http @PORT@ --splash

Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
