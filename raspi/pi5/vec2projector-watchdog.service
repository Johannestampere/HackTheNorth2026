# /etc/systemd/system/vec2projector-watchdog.service
# Paired with the .timer: restarts the display if /health stops looking healthy.
[Unit]
Description=restart vec2projector if it stops drawing

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'curl -sf --max-time 5 http://127.0.0.1:8080/health | grep -q \'"ok": true\' || systemctl restart vec2projector'
